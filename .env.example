# Formulieren → e-mail.
# Zet deze waarden als omgevingsvariabelen bij de hosting (Hostinger hPanel of Lovable),
# en lokaal in .env.local. Zet ze NOOIT in .env: dat bestand staat wél in git.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465                      # 465 = TLS direct, 587 = STARTTLS
SMTP_USER=britt@b-analyzed.com     # het mailadres zelf is de gebruikersnaam
SMTP_PASS=                         # wachtwoord van die mailbox

LEAD_TO_EMAIL=info@b-analyzed.com  # waar de aanvragen binnenkomen
LEAD_FROM_EMAIL=britt@b-analyzed.com  # moet gelijk zijn aan SMTP_USER
LEAD_FROM_NAME=B. Analyzed website

# Optionele achtervang via Resend; alleen nodig als SMTP niet beschikbaar is.
# LOVABLE_API_KEY=
# RESEND_API_KEY=
